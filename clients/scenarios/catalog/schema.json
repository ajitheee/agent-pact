{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenario:catalog",
  "type": "array",
  "minItems": 6,
  "maxItems": 6,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "required": [
      "sku",
      "name",
      "price_cents",
      "currency",
      "in_stock"
    ],
    "additionalProperties": false,
    "properties": {
      "sku": {
        "type": "string",
        "pattern": "^[A-Z]{3}-[0-9]{3}$"
      },
      "name": {
        "type": "string",
        "minLength": 2
      },
      "price_cents": {
        "type": "integer",
        "minimum": 1
      },
      "currency": {
        "enum": [
          "USD",
          "EUR"
        ]
      },
      "in_stock": {
        "type": "boolean"
      }
    }
  }
}