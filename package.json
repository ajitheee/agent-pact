{
  "name": "agent-task-escrow",
  "version": "1.0.0",
  "description": "Verification layer for agent-to-agent payments: escrow released only when a machine-checkable verifier passes.",
  "scripts": {
    "dev": "mcp-use dev",
    "build": "mcp-use build",
    "start": "mcp-use start",
    "deploy": "node scripts/deploy.mjs",
    "agent": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/agent.ts",
    "demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx demo/run.ts",
    "test": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "setup:clients": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/setup-clients.ts",
    "worker:a": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx clients/worker-a.ts",
    "poster": "node scripts/run-poster.mjs",
    "blaxel:smoke": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/blaxel-smoke.ts",
    "live": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/live.ts",
    "preflight": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/preflight.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@blaxel/core": "^0.3.30",
    "@electric-sql/pglite": "^0.5.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mcp-use": "^2.10.1",
    "postgres": "^3.4.9",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.302",
    "@mcp-use/client": "^2.4.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  }
}
